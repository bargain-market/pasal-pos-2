<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>

<BorderPane fx:controller="com.pos.ui.keyboard.FloatingKeyboardController"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="600.0" prefHeight="268.0" minWidth="480.0" maxWidth="600.0"
            styleClass="floating-keyboard-root">

    <top>
        <HBox fx:id="titleBar" spacing="8.0" styleClass="floating-keyboard-titlebar">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="Keyboard" HBox.hgrow="ALWAYS" />
            <Button text="✕"
                    onAction="#onCloseClicked"
                    styleClass="floating-keyboard-close-button"/>
        </HBox>
    </top>

    <center>
        <GridPane hgap="4.0" vgap="4.0" maxWidth="Infinity">
            <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
            <columnConstraints>
                <ColumnConstraints percentWidth="7.69"/>
                <ColumnConstraints percentWidth="7.69"/>
                <ColumnConstraints percentWidth="7.69"/>
                <ColumnConstraints percentWidth="7.69"/>
                <ColumnConstraints percentWidth="7.69"/>
                <ColumnConstraints percentWidth="7.69"/>
                <ColumnConstraints percentWidth="7.69"/>
                <ColumnConstraints percentWidth="7.69"/>
                <ColumnConstraints percentWidth="7.69"/>
                <ColumnConstraints percentWidth="7.69"/>
                <ColumnConstraints percentWidth="7.69"/>
                <ColumnConstraints percentWidth="7.69"/>
                <ColumnConstraints percentWidth="7.69"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints percentHeight="25"/>
                <RowConstraints percentHeight="25"/>
                <RowConstraints percentHeight="25"/>
                <RowConstraints percentHeight="25"/>
            </rowConstraints>

            <!-- Row 1 -->
            <Button text="1" GridPane.rowIndex="0" GridPane.columnIndex="0" maxWidth="Infinity" onAction="#onKeyClicked"/>
            <Button text="2" GridPane.rowIndex="0" GridPane.columnIndex="1" onAction="#onKeyClicked"/>
            <Button text="3" GridPane.rowIndex="0" GridPane.columnIndex="2" onAction="#onKeyClicked"/>
            <Button text="4" GridPane.rowIndex="0" GridPane.columnIndex="3" onAction="#onKeyClicked"/>
            <Button text="5" GridPane.rowIndex="0" GridPane.columnIndex="4" onAction="#onKeyClicked"/>
            <Button text="6" GridPane.rowIndex="0" GridPane.columnIndex="5" onAction="#onKeyClicked"/>
            <Button text="7" GridPane.rowIndex="0" GridPane.columnIndex="6" onAction="#onKeyClicked"/>
            <Button text="8" GridPane.rowIndex="0" GridPane.columnIndex="7" onAction="#onKeyClicked"/>
            <Button text="9" GridPane.rowIndex="0" GridPane.columnIndex="8" onAction="#onKeyClicked"/>
            <Button text="0" GridPane.rowIndex="0" GridPane.columnIndex="9" onAction="#onKeyClicked"/>
            <Button text="BACKSPACE" GridPane.rowIndex="0" GridPane.columnIndex="10" GridPane.columnSpan="3" maxWidth="Infinity" onAction="#onSpecialKeyClicked"/>

            <!-- Row 2 -->
            <Button text="Q" GridPane.rowIndex="1" GridPane.columnIndex="0" onAction="#onKeyClicked"/>
            <Button text="W" GridPane.rowIndex="1" GridPane.columnIndex="1" onAction="#onKeyClicked"/>
            <Button text="E" GridPane.rowIndex="1" GridPane.columnIndex="2" onAction="#onKeyClicked"/>
            <Button text="R" GridPane.rowIndex="1" GridPane.columnIndex="3" onAction="#onKeyClicked"/>
            <Button text="T" GridPane.rowIndex="1" GridPane.columnIndex="4" onAction="#onKeyClicked"/>
            <Button text="Y" GridPane.rowIndex="1" GridPane.columnIndex="5" onAction="#onKeyClicked"/>
            <Button text="U" GridPane.rowIndex="1" GridPane.columnIndex="6" onAction="#onKeyClicked"/>
            <Button text="I" GridPane.rowIndex="1" GridPane.columnIndex="7" onAction="#onKeyClicked"/>
            <Button text="O" GridPane.rowIndex="1" GridPane.columnIndex="8" onAction="#onKeyClicked"/>
            <Button text="P" GridPane.rowIndex="1" GridPane.columnIndex="9" onAction="#onKeyClicked"/>

            <!-- Row 3 -->
            <Button text="A" GridPane.rowIndex="2" GridPane.columnIndex="1" onAction="#onKeyClicked"/>
            <Button text="S" GridPane.rowIndex="2" GridPane.columnIndex="2" onAction="#onKeyClicked"/>
            <Button text="D" GridPane.rowIndex="2" GridPane.columnIndex="3" onAction="#onKeyClicked"/>
            <Button text="F" GridPane.rowIndex="2" GridPane.columnIndex="4" onAction="#onKeyClicked"/>
            <Button text="G" GridPane.rowIndex="2" GridPane.columnIndex="5" onAction="#onKeyClicked"/>
            <Button text="H" GridPane.rowIndex="2" GridPane.columnIndex="6" onAction="#onKeyClicked"/>
            <Button text="J" GridPane.rowIndex="2" GridPane.columnIndex="7" onAction="#onKeyClicked"/>
            <Button text="K" GridPane.rowIndex="2" GridPane.columnIndex="8" onAction="#onKeyClicked"/>
            <Button text="L" GridPane.rowIndex="2" GridPane.columnIndex="9" onAction="#onKeyClicked"/>

            <!-- Row 4 -->
            <Button text="CLEAR" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2" maxWidth="Infinity" onAction="#onSpecialKeyClicked"/>
            <Button text="Z" GridPane.rowIndex="3" GridPane.columnIndex="2" onAction="#onKeyClicked"/>
            <Button text="X" GridPane.rowIndex="3" GridPane.columnIndex="3" onAction="#onKeyClicked"/>
            <Button text="C" GridPane.rowIndex="3" GridPane.columnIndex="4" onAction="#onKeyClicked"/>
            <Button text="V" GridPane.rowIndex="3" GridPane.columnIndex="5" onAction="#onKeyClicked"/>
            <Button text="B" GridPane.rowIndex="3" GridPane.columnIndex="6" onAction="#onKeyClicked"/>
            <Button text="N" GridPane.rowIndex="3" GridPane.columnIndex="7" onAction="#onKeyClicked"/>
            <Button text="M" GridPane.rowIndex="3" GridPane.columnIndex="8" onAction="#onKeyClicked"/>
            <Button text="." GridPane.rowIndex="3" GridPane.columnIndex="9" onAction="#onKeyClicked"/>
            <Button text="SPACE" GridPane.rowIndex="3" GridPane.columnIndex="10" maxWidth="Infinity" onAction="#onSpecialKeyClicked"/>
            <Button text="ENTER" GridPane.rowIndex="3" GridPane.columnIndex="11" GridPane.columnSpan="2" maxWidth="Infinity" onAction="#onSpecialKeyClicked"/>
        </GridPane>
    </center>

</BorderPane>


