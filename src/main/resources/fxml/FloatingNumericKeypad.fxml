<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>

<BorderPane fx:controller="com.pos.ui.keyboard.FloatingNumericKeypadController"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="320.0" prefHeight="380.0"
            styleClass="floating-keypad-root">

    <top>
        <HBox fx:id="titleBar" spacing="8.0" styleClass="floating-keypad-titlebar">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
            <Label fx:id="titleLabel" text="Enter Amount" HBox.hgrow="ALWAYS" 
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Button text="✕"
                    onAction="#onCloseClicked"
                    styleClass="floating-keypad-close-button"
                    accessibleText="Close">
                <tooltip>
                    <Tooltip text="Close"/>
                </tooltip>
            </Button>
        </HBox>
    </top>

    <center>
        <GridPane fx:id="keypadGrid" hgap="8.0" vgap="8.0" styleClass="keypad-grid">
            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
            <columnConstraints>
                <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints percentHeight="25" vgrow="ALWAYS"/>
                <RowConstraints percentHeight="25" vgrow="ALWAYS"/>
                <RowConstraints percentHeight="25" vgrow="ALWAYS"/>
                <RowConstraints percentHeight="25" vgrow="ALWAYS"/>
            </rowConstraints>

            <!-- Row 0: 7 8 9 ⌫ -->
            <Button text="7" GridPane.rowIndex="0" GridPane.columnIndex="0" 
                    onAction="#onKeyClicked" styleClass="keypad-number-btn" maxWidth="Infinity" maxHeight="Infinity"/>
            <Button text="8" GridPane.rowIndex="0" GridPane.columnIndex="1" 
                    onAction="#onKeyClicked" styleClass="keypad-number-btn" maxWidth="Infinity" maxHeight="Infinity"/>
            <Button text="9" GridPane.rowIndex="0" GridPane.columnIndex="2" 
                    onAction="#onKeyClicked" styleClass="keypad-number-btn" maxWidth="Infinity" maxHeight="Infinity"/>
            <Button text="⌫" GridPane.rowIndex="0" GridPane.columnIndex="3" 
                    onAction="#onBackspaceClicked" styleClass="keypad-action-btn" maxWidth="Infinity" maxHeight="Infinity"
                    accessibleText="Backspace">
                <tooltip>
                    <Tooltip text="Backspace"/>
                </tooltip>
            </Button>

            <!-- Row 1: 4 5 6 C -->
            <Button text="4" GridPane.rowIndex="1" GridPane.columnIndex="0" 
                    onAction="#onKeyClicked" styleClass="keypad-number-btn" maxWidth="Infinity" maxHeight="Infinity"/>
            <Button text="5" GridPane.rowIndex="1" GridPane.columnIndex="1" 
                    onAction="#onKeyClicked" styleClass="keypad-number-btn" maxWidth="Infinity" maxHeight="Infinity"/>
            <Button text="6" GridPane.rowIndex="1" GridPane.columnIndex="2" 
                    onAction="#onKeyClicked" styleClass="keypad-number-btn" maxWidth="Infinity" maxHeight="Infinity"/>
            <Button text="C" GridPane.rowIndex="1" GridPane.columnIndex="3" 
                    onAction="#onClearClicked" styleClass="keypad-clear-btn" maxWidth="Infinity" maxHeight="Infinity"
                    accessibleText="Clear">
                <tooltip>
                    <Tooltip text="Clear"/>
                </tooltip>
            </Button>

            <!-- Row 2: 1 2 3 ↵ (Enter spans 2 rows) -->
            <Button text="1" GridPane.rowIndex="2" GridPane.columnIndex="0" 
                    onAction="#onKeyClicked" styleClass="keypad-number-btn" maxWidth="Infinity" maxHeight="Infinity"/>
            <Button text="2" GridPane.rowIndex="2" GridPane.columnIndex="1" 
                    onAction="#onKeyClicked" styleClass="keypad-number-btn" maxWidth="Infinity" maxHeight="Infinity"/>
            <Button text="3" GridPane.rowIndex="2" GridPane.columnIndex="2" 
                    onAction="#onKeyClicked" styleClass="keypad-number-btn" maxWidth="Infinity" maxHeight="Infinity"/>
            <Button fx:id="enterBtn" text="↵" GridPane.rowIndex="2" GridPane.columnIndex="3" GridPane.rowSpan="2"
                    onAction="#onEnterClicked" styleClass="keypad-enter-btn" maxWidth="Infinity" maxHeight="Infinity"
                    accessibleText="Enter">
                <tooltip>
                    <Tooltip text="Enter"/>
                </tooltip>
            </Button>

            <!-- Row 3: 0 00 . -->
            <Button text="0" GridPane.rowIndex="3" GridPane.columnIndex="0" 
                    onAction="#onKeyClicked" styleClass="keypad-number-btn" maxWidth="Infinity" maxHeight="Infinity"/>
            <Button fx:id="doubleZeroBtn" text="00" GridPane.rowIndex="3" GridPane.columnIndex="1" 
                    onAction="#onDoubleZeroClicked" styleClass="keypad-number-btn" maxWidth="Infinity" maxHeight="Infinity"
                    accessibleText="Double Zero">
                <tooltip>
                    <Tooltip text="Double Zero"/>
                </tooltip>
            </Button>
            <Button fx:id="decimalBtn" text="." GridPane.rowIndex="3" GridPane.columnIndex="2" 
                    onAction="#onKeyClicked" styleClass="keypad-decimal-btn" maxWidth="Infinity" maxHeight="Infinity"
                    accessibleText="Decimal Point">
                <tooltip>
                    <Tooltip text="Decimal Point"/>
                </tooltip>
            </Button>
        </GridPane>
    </center>

</BorderPane>
